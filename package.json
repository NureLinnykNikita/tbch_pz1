{
  "name": "pz1-typescript-blockchain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "network": "node scripts/network.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.ts",
    "benchmark": "node scripts/benchmark.ts",
    "lint": "eslint src scripts tests",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.json\" eslint.config.js README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.json\" eslint.config.js README.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  }
}
